# SPA React Router — toutes les routes inconnues servent index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laisser passer les fichiers et dossiers réellement présents (assets, .htaccess…)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste → index.html (le routing est géré côté client par React Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Politique de cache
<IfModule mod_headers.c>
  # Les assets sont hashés par Vite → cache long immuable
  <FilesMatch "\.(js|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html ne doit jamais être mis en cache (sinon les anciens hash persistent)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
