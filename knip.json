{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreDependencies": [
    "@types/chrome"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "tailwind.config.{js,cjs,ts}",
        "postcss.config.{js,cjs}",
        "src/**/*.test.{ts,tsx}",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "src/components/ui/**",
        "src/types/fabric.d.ts"
      ],
      "ignoreBinaries": [
        "firebase"
      ]
    },
    "functions": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreBinaries": [
        "firebase"
      ]
    }
  }
}