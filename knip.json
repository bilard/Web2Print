{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreDependencies": ["dotenv", "express", "@types/chrome"],
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "tailwind.config.{js,cjs,ts}",
        "postcss.config.{js,cjs}",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "src/components/ui/**",
        "src/types/fabric.d.ts"
      ]
    },
    "functions": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["firebase"]
    }
  }
}
