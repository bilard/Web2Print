rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ibs.studio@gmail.com';
    }

    function isOwner(resource) {
      return resource.data.ownerId == request.auth.uid;
    }

    function isCollaborator(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(request.auth.uid));
    }

    // ── RBAC serveur (Phase 4) ────────────────────────────────────────────────
    // Les permissions vivent dans users/{uid} (accessRoleId / accessGrants /
    // accessRevokes / accessBlocked) + roles/{roleId}.permissions — mêmes données
    // que useCan côté client (computePermissions.ts). Ici on les RÉ-IMPOSE côté
    // serveur : un client modifié ne peut pas écrire au-delà de son rôle.
    // L'owner (isAdmin) bypasse tout, comme côté client. Les get() répétés sur le
    // même doc sont dédupliqués par Firestore (1 lecture facturée par requête).

    function accessData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRoleAssigned() {
      return accessData().get('accessRoleId', null) is string && accessData().accessRoleId != '';
    }

    // Compte actif = non bloqué ET rôle assigné (un compte « pending » de
    // l'onboarding open+pending ne peut rien écrire ni lire de partagé).
    function isActiveUser() {
      return isAuthenticated() && (isAdmin() || (
        accessData().get('accessBlocked', false) != true && hasRoleAssigned()
      ));
    }

    // Permission effective : revokes > grants > permissions du rôle (même
    // précédence que computeEffectivePermissions côté client).
    function hasPermission(key) {
      return isAuthenticated() && (isAdmin() || (
        accessData().get('accessBlocked', false) != true &&
        !(key in accessData().get('accessRevokes', [])) &&
        (key in accessData().get('accessGrants', []) ||
         (hasRoleAssigned() &&
          key in get(/databases/$(database)/documents/roles/$(accessData().accessRoleId)).data.get('permissions', [])))
      ));
    }

    function hasEditorRole(projectId) {
      let collab = get(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(request.auth.uid));
      return collab.data.role == 'editor';
    }

    // ── Quotas comptes démo ───────────────────────────────────────────────────
    // Un compte porteur de la permission-marqueur 'demo.view' (cf. permissions.ts)
    // est plafonné en volume de données. ⚠ Limites (50/20) dupliquées côté client
    // (DEMO_LIMITS) et dans functions/dam/damUpload.ts — tenir les 3 en phase.
    function isDemo() {
      return isAuthenticated() && !isAdmin() && hasPermission('demo.view');
    }
    function usageOf(field) {
      return accessData().get('usage', {}).get(field, 0);
    }
    // Création autorisée tant que le compteur reste sous la limite (non-démo = illimité).
    function withinQuota(field, limit) {
      return !isDemo() || usageOf(field) < limit;
    }
    // Interdit au user de DÉCROÎTRE ses compteurs d'usage (anti-reset du quota).
    function usageMonotonic() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['usage'])
        || (request.resource.data.get('usage', {}).get('pimRows', 0) >= resource.data.get('usage', {}).get('pimRows', 0)
         && request.resource.data.get('usage', {}).get('damAssets', 0) >= resource.data.get('usage', {}).get('damAssets', 0));
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    // ── Roles (RBAC) ──────────────────────────────────────────────────────────
    match /roles/{roleId} {
      allow read:  if isAuthenticated();   // listes de permissions, non secrètes
      allow write: if isAdmin();
    }

    match /users/{uid} {
      // Lecture : soi-même ou l'admin.
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // L'admin écrit tout (assignation rôle + surcharges). Le user écrit son propre doc
      // (profil, secrets perso) SAUF les champs d'accès RBAC — sinon il pourrait s'auto-
      // attribuer des permissions (escalade de privilèges). Create/update séparés car
      // `resource` est null à la création du doc.
      allow create: if isAdmin()
                    || (isAuthenticated() && request.auth.uid == uid
                        && !request.resource.data.keys().hasAny(['accessRoleId', 'accessGrants', 'accessRevokes', 'accessBlocked']));
      // Le user peut écrire son propre `usage` (compteurs de quota) mais jamais le
      // DÉCROÎTRE (usageMonotonic) : seul l'admin peut réinitialiser un quota démo.
      allow update: if isAdmin()
                    || (isAuthenticated() && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessRoleId', 'accessGrants', 'accessRevokes', 'accessBlocked'])
                        && usageMonotonic());
      // Suppression du profil : admin uniquement (écran « Utilisateurs & rôles »).
      allow delete: if isAdmin();
    }

    // ── Plugin Tokens ─────────────────────────────────────────────────────
    // Tokens du plugin InDesign : créés/listés/révoqués par leur propriétaire.
    // Le doc-id est le sha256 du token ; on ne stocke jamais le token en clair.
    match /pluginTokens/{tokenId} {
      allow read, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    // ── Projects ──────────────────────────────────────────────────────────────

    match /projects/{projectId} {
      // Lecture : propriétaire ou collaborateur
      allow read: if isAuthenticated() &&
                     (isOwner(resource) || isCollaborator(projectId));

      // Création : permission library.create (ou import.view — les imports
      // IDML/PPTX/SVG créent aussi des projets), devient propriétaire.
      allow create: if (hasPermission('library.create') || hasPermission('import.view')) &&
                       request.resource.data.ownerId == request.auth.uid;

      // Mise à jour : propriétaire ou collaborateur editor, compte actif.
      allow update: if isActiveUser() &&
                       (isOwner(resource) || hasEditorRole(projectId));

      // Suppression : propriétaire avec permission library.delete.
      allow delete: if hasPermission('library.delete') && isOwner(resource);

      // ── Gallery (projet) ─────────────────────────────────────────────────

      match /gallery/{imageId} {
        allow read:  if isAuthenticated() &&
                        (isOwner(get(/databases/$(database)/documents/projects/$(projectId))) ||
                         isCollaborator(projectId));
        allow create: if isActiveUser() &&
                         (isOwner(get(/databases/$(database)/documents/projects/$(projectId))) ||
                          hasEditorRole(projectId));
        allow update, delete: if isActiveUser() &&
                                 (isOwner(get(/databases/$(database)/documents/projects/$(projectId))) ||
                                  hasEditorRole(projectId));
      }

      // ── Versions (historique du document) ────────────────────────────────
      // Snapshots de contenu créés/restaurés depuis le panneau Versions.
      // `update` requis : les snapshots AUTO (ring buffer auto-0..auto-9,
      // autoSnapshot.ts) réécrivent leurs slots via setDoc.
      match /versions/{versionId} {
        allow read:  if isAuthenticated() &&
                        (isOwner(get(/databases/$(database)/documents/projects/$(projectId))) ||
                         isCollaborator(projectId));
        allow create, update, delete: if isActiveUser() &&
                                         (isOwner(get(/databases/$(database)/documents/projects/$(projectId))) ||
                                          hasEditorRole(projectId));
      }

      // ── Collaborators ──────────────────────────────────────────────────────

      match /collaborators/{collaboratorUid} {
        // Lecture : propriétaire ou le collaborateur lui-même
        allow read: if isAuthenticated() &&
                       (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        request.auth.uid == collaboratorUid);

        // Ajout/suppression : propriétaire du projet uniquement
        allow write: if isAuthenticated() &&
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // ── Gallery (NanoBana) ─────────────────────────────────────────────────────

    match /users/{uid}/gallery/{imageId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ── Chat Prompts ──────────────────────────────────────────────────────────
    // Bibliothèque de prompts personnels du module Chat IA.
    // Stockée sous users/{uid}/prompts/{promptId} — privée à chaque user.

    match /users/{uid}/prompts/{promptId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Bibliothèque de prompts du module Annimation (vidéo) — privée à chaque user.
    match /users/{uid}/videoPrompts/{promptId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ── Workflows ────────────────────────────────────────────────────────────
    // Workflows d'orchestration (à la Make/n8n) sous users/{uid}/workflows/{id}.
    // Privés à chaque user — pas de partage au MVP (phase 2 : champ sharedWith).

    match /users/{uid}/workflows/{workflowId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow create: if hasPermission('workflows.create') && request.auth.uid == uid;
      allow update: if hasPermission('workflows.edit') && request.auth.uid == uid;
      allow delete: if hasPermission('workflows.delete') && request.auth.uid == uid;
    }

    // Dossiers de regroupement des workflows (organisation de la liste).
    match /users/{uid}/workflowFolders/{folderId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow create: if hasPermission('workflows.create') && request.auth.uid == uid;
      allow update: if hasPermission('workflows.edit') && request.auth.uid == uid;
      allow delete: if hasPermission('workflows.delete') && request.auth.uid == uid;
    }

    // Modèles de workflow créés par l'utilisateur (privés, réutilisables).
    match /users/{uid}/workflowTemplates/{templateId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow create: if hasPermission('workflows.create') && request.auth.uid == uid;
      allow update: if hasPermission('workflows.edit') && request.auth.uid == uid;
      allow delete: if hasPermission('workflows.delete') && request.auth.uid == uid;
    }

    // Modèles promo personnalisés (module Promo Retail).
    match /users/{uid}/promoTemplates/{templateId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow write:  if hasPermission('retailPromo.edit') && request.auth.uid == uid;
    }

    // Catalogues multi-pages (module Catalogue studio).
    match /users/{uid}/catalogs/{catalogId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow write:  if hasPermission('catalog.edit') && request.auth.uid == uid;
    }
    match /users/{uid}/catalogTemplates/{templateId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow write:  if hasPermission('catalog.edit') && request.auth.uid == uid;
    }

    // Polices utilisateur (« Mes polices ») — méta des fichiers uploadés dans
    // Storage users/{uid}/fonts/ ; privées à chaque user (cf. features/fonts).
    match /users/{uid}/userFonts/{fontId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Fiches promo enregistrées (méta + lignes payload), module Promo Retail.
    match /users/{uid}/promos/{promoId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow write:  if hasPermission('retailPromo.edit') && request.auth.uid == uid;
    }
    match /users/{uid}/promoPayloads/{promoId} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow write:  if hasPermission('retailPromo.edit') && request.auth.uid == uid;
    }

    // État du node « Veille prix » + module « Veille tarifaire » : le doc de suivi
    // {watchId} ET ses sous-collections (products / sites / matches / history).
    // Wildcard récursif car les règles ne cascadent pas aux sous-collections.
    match /users/{uid}/priceWatch/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Historique des runs serveur (écrit par les Functions, lu par le propriétaire).
    match /users/{uid}/workflowRuns/{runId} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // Le serveur (admin) écrit l'historique des runs cron/serveur ; le propriétaire
      // persiste en plus ses runs client (snapshot de résultat) et purge les anciens.
      allow create, delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // État LIVE du dernier run serveur par workflow (progression affichée sur les
    // cartes de l'éditeur). Écrit par les Functions, lu par le propriétaire.
    match /users/{uid}/workflowRunsLive/{workflowId} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false; // écrit uniquement par les Functions (admin)
    }

    // Flag d'abandon d'un run serveur en cours : le propriétaire l'écrit (bouton STOP),
    // l'executor headless le poll et déclenche l'AbortController.
    match /users/{uid}/workflowAbort/{workflowId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ── Excel Data ────────────────────────────────────────────────────────────
    // `excel_data/{docId}` = méta légères (fileName, path, sortIndex, totals…)
    // `excel_data_payload/{docId}` = blob `sheets` JSON sérialisé, séparé pour
    // que les listings n'aient pas à charger le payload complet à chaque refresh.
    // Le `docId` est commun entre les deux collections.

    // ⚠ Store Excel LEGACY, écrit AUSSI par /data (dual-store). Gaté par userId seul
    // (pas de permission). Pour ne pas laisser une porte de côté au quota démo, on
    // plafonne la TAILLE d'un dataset démo : méta à ≤ 50 lignes (= DEMO_LIMITS.pimRows),
    // payload à ≤ 500k caractères. Le save = batch atomique (méta + payload) → refuser
    // l'un refuse tout. Plafond PAR dataset (pas cumulé) : suffisant vu que l'import est
    // déjà borné à 50 côté PIM et que les données sont isolées par userId.
    match /excel_data/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
                    && (!isDemo() || request.resource.data.get('totalRows', 0) <= 50);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && (!isDemo() || request.resource.data.get('totalRows', 0) <= 50);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /excel_data_payload/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
                    && (!isDemo() || request.resource.data.get('json', '').size() <= 500000);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && (!isDemo() || request.resource.data.get('json', '').size() <= 500000);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── PIM Projects ─────────────────────────────────────────────────────────
    // Projet PIM = doc dans `pim_projects` avec sous-collection `products`.
    // Le doc projet contient userId (propriétaire). Les products héritent des
    // permissions du parent via lookup.

    match /pim_projects/{projectId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if hasPermission('pim.create') && request.resource.data.userId == request.auth.uid;
      allow update: if hasPermission('pim.edit') && resource.data.userId == request.auth.uid;
      allow delete: if hasPermission('pim.delete') && resource.data.userId == request.auth.uid;

      // Sous-collection products : autorisé si l'utilisateur possède le projet parent.
      // Note: lors de la création (avant que le parent existe), on autorise si le parent
      // est en cours d'écriture par le même user (le batch écrit parent + products).
      match /products/{productId} {
        allow read: if isAuthenticated() && (
          (exists(/databases/$(database)/documents/pim_projects/$(projectId)) &&
           get(/databases/$(database)/documents/pim_projects/$(projectId)).data.userId == request.auth.uid)
          ||
          !exists(/databases/$(database)/documents/pim_projects/$(projectId))
        );
        // Écriture : il faut en plus une permission PIM mutante (edit couvre
        // l'édition manuelle, import/scrape écrivent aussi des produits).
        // Édition/suppression de produits existants : pas de quota (ne fait pas croître le volume).
        allow update, delete: if (hasPermission('pim.edit') || hasPermission('pim.import') || hasPermission('pim.scrape')) && (
          (exists(/databases/$(database)/documents/pim_projects/$(projectId)) &&
           get(/databases/$(database)/documents/pim_projects/$(projectId)).data.userId == request.auth.uid)
          ||
          // Pendant la création du projet (parent pas encore committé) : autoriser si le user
          // matchera userId du parent en cours d'écriture. On ne peut pas vérifier le parent
          // dans le même batch, donc fallback : autoriser tout user authentifié à créer/écrire
          // s'il n'y a pas encore de parent. Audit léger via la règle parent qui exigera
          // userId == auth.uid au moment du commit du batch.
          !exists(/databases/$(database)/documents/pim_projects/$(projectId))
        );
        // Création d'un produit (ajout d'une ligne) : permission + possession du parent,
        // MAIS interdite en DIRECT aux comptes démo (!isDemo). Un démo ne peut ajouter des
        // produits QUE via la Cloud Function pimSaveProducts (Admin SDK, hors rules), qui
        // impose le quota users/{uid}.usage.pimRows → plafond serveur infalsifiable.
        allow create: if (hasPermission('pim.edit') || hasPermission('pim.import') || hasPermission('pim.scrape')) && !isDemo() && (
          (exists(/databases/$(database)/documents/pim_projects/$(projectId)) &&
           get(/databases/$(database)/documents/pim_projects/$(projectId)).data.userId == request.auth.uid)
          ||
          !exists(/databases/$(database)/documents/pim_projects/$(projectId))
        );
      }
    }

    // ── Briefs ────────────────────────────────────────────────────────────────

    match /briefs/{briefId} {
      allow read:   if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if hasPermission('taxonomies.briefs') && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isActiveUser() && resource.data.ownerId == request.auth.uid;

      // Sous-collection : images générées
      match /images/{imageId} {
        allow read, write: if isAuthenticated() &&
                              get(/databases/$(database)/documents/briefs/$(briefId)).data.ownerId == request.auth.uid;
      }
    }

    // ── Taxonomies ────────────────────────────────────────────────────────────

    match /taxonomies/{taxonomyId} {
      allow read:   if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if hasPermission('taxonomies.edit') && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if hasPermission('taxonomies.edit') && resource.data.ownerId == request.auth.uid;
    }

    // ── DAM Assets ────────────────────────────────────────────────────────────

    // DAM Assets — données PARTAGÉES entre comptes : lecture réservée aux
    // comptes actifs (pas aux pending/bloqués), écritures gatées par permission.
    match /dam_assets/{assetId} {
      allow read: if isActiveUser();
      // Création plafonnée par le quota démo (compteur partagé users/{uid}.usage.damAssets,
      // aussi alimenté par la CF damUpload pour les uploads Drive).
      allow create: if hasPermission('dam.upload') && withinQuota('damAssets', 20);
      allow update: if hasPermission('dam.edit') && resource.data.addedBy == request.auth.uid;
      allow delete: if hasPermission('dam.delete') && resource.data.addedBy == request.auth.uid;
    }

    // DAM Collections — partagées : lecture comptes actifs, écriture par owner
    match /dam_collections/{collectionId} {
      allow read: if isActiveUser();
      allow create: if hasPermission('dam.collection');
      allow update, delete: if hasPermission('dam.collection') && resource.data.ownerId == request.auth.uid;
    }

    // DAM Favorites — chaque user gère ses propres favoris
    match /dam_favorites/{favId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // DAM Variants — versions éditées d'images, privées à chaque user
    match /dam_variants/{variantId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow list: if isActiveUser();
      allow create: if hasPermission('dam.edit') && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if hasPermission('dam.edit') && resource.data.ownerId == request.auth.uid;
    }

    // DAM Popular Searches — lecture seule pour les comptes actifs
    match /dam_popular_searches/{docId} {
      allow read: if isActiveUser();
    }

    // ── Scraping Templates ──────────────────────────────────────────────────
    // Templates de scraping par fournisseur — lecture/écriture pour tous les
    // utilisateurs authentifiés (ressources partagées entre les comptes du PIM).
    // Ressources partagées entre comptes : lecture = compte actif,
    // écriture = permission d'édition des templates.
    match /scrapingTemplates/{templateId} {
      allow read:   if isActiveUser();
      allow create, update, delete: if hasPermission('scrapingTemplates.edit');
    }

    // ── Scraping Rules ──────────────────────────────────────────────────────
    // Document unique `scrapingRules/global` : markdown partagé décrivant les
    // règles rédactionnelles du scraping. Lecture/écriture pour tous les users
    // authentifiés (édité via l'onglet Règles du Scraping Hub).
    match /scrapingRules/{docId} {
      allow read:  if isActiveUser();
      allow write: if hasPermission('scrapingHub.edit');
    }

    // ── AI Usage tracking — agrégat mensuel par user ────────────────────────
    // Document `aiUsage/{uid}_{YYYY-MM}` accumulant tokens/coût par provider.
    // Lecture autorisée uniquement si docId préfixé par l'UID du caller (cf
    // useUsageStats qui fait getDoc(`${uid}_${month}`)). Écriture (create/update
    // via setDoc merge depuis recordAiUsage) requiert ownerId === auth.uid.
    match /aiUsage/{docId} {
      allow read:   if request.auth != null && docId.matches('^' + request.auth.uid + '_\\d{4}-\\d{2}$');
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                                            && request.resource.data.ownerId == request.auth.uid;
    }

    // ── Bright Data Usage tracking — compteur de requêtes mensuel ──────────
    // Document `brightDataUsage/{uid}_{YYYY-MM}` incrémenté par recordBrightDataUsage()
    // après chaque appel scrapeWithBrightData réussi. Même schéma de protection
    // que aiUsage : lecture/écriture par le owner uniquement.
    match /brightDataUsage/{docId} {
      allow read:   if request.auth != null && docId.matches('^' + request.auth.uid + '_\\d{4}-\\d{2}$');
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                                            && request.resource.data.ownerId == request.auth.uid;
    }

    // ── Remove.bg Usage tracking — compteur d'images mensuel ───────────────
    // Document `removebgUsage/{uid}_{YYYY-MM}` incrémenté par recordRemoveBgUsage()
    // après chaque suppression de fond réussie. Clé Remove.bg propre à chaque user
    // → conso per-user. Même schéma de protection que aiUsage/brightDataUsage.
    match /removebgUsage/{docId} {
      allow read:   if request.auth != null && docId.matches('^' + request.auth.uid + '_\\d{4}-\\d{2}$');
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                                            && request.resource.data.ownerId == request.auth.uid;
    }

    // ── Animations HTML ────────────────────────────────────────────────────
    // Métadonnées des animations HTML/CSS/JS sauvegardées dans le DAM (le ZIP
    // lui-même est dans Storage `dam/html-animations/{uid}/`). Le doc contient
    // composition / styleConfig / aspect pour permettre une preview live sans
    // re-télécharger le ZIP.
    match /animations/{animationId} {
      allow read:   if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Videos (legacy, lecture seule) ─────────────────────────────────────
    // Anciennes vidéos MP4 générées par le service Cloud Run avant le passage
    // au flow ZIP-only. Plus de création possible côté client ; lecture/suppression
    // restent pour permettre de nettoyer les enregistrements historiques.
    match /videos/{renderId} {
      allow read:   if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Print Presets (familles de paramètres d'impression) ────────────────
    // Presets réutilisables entre projets, scopés au user via ownerId.
    match /printPresets/{presetId} {
      allow read:   if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow list:   if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── App config ──────────────────────────────────────────────────────────
    // Documents de configuration/secrets d'infrastructure (token Bright Data API, lien
    // Scraping Browser WSS, etc.). C'est un secret PARTAGÉ entre tous les comptes, pas une
    // donnée par-utilisateur → réservé à l'owner (admin) : lui seul lit/édite ces réglages
    // depuis l'UI (SettingsPanel → Bright Data). Les autres comptes restent bloqués (pas de
    // fuite du token partagé). Les Cloud Functions (Admin SDK) bypassent ces règles de toute
    // façon ; le token reste aussi disponible via Secret Manager (BRIGHTDATA_API_TOKEN).
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Plannings cron de workflow ────────────────────────────────────────────
    // Plannings cron de workflow (un doc par workflow). Le client lit/écrit les siens ;
    // le scanner serveur (admin) contourne ces règles.
    match /workflowSchedules/{workflowId} {
      // resource == null : un doc absent doit rester lisible, sinon l'onSnapshot
      // de l'éditeur meurt en permission-denied avant la création du planning.
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── États OAuth Google (accès serveur) ────────────────────────────────────
    // Doc à usage unique créé par le client juste avant d'ouvrir le consentement
    // Google ; lu/supprimé par la Function googleOAuthCallback (admin). Jamais
    // lisible côté client.
    match /googleOAuthStates/{nonce} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── Webhooks entrants de workflow ─────────────────────────────────────────
    // Un doc par workflow : { uid, secret, enabled }. Créé/géré par le propriétaire
    // depuis l'éditeur ; la Function workflowWebhook (admin) le lit pour valider
    // le secret et met à jour lastTriggeredAt/lastStatus.
    match /workflowWebhooks/{workflowId} {
      // resource == null : idem workflowSchedules — l'onSnapshot du panneau Webhook
      // s'abonne avant l'activation, le doc n'existe pas encore.
      allow read:   if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid
                                         && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Approbations de workflow (node « Approbation Telegram ») ─────────────
    // Doc d'attente créé par le run client ; la DÉCISION (approved/rejected) est
    // écrite par la Function webhook (admin, contourne ces règles). Le client ne
    // peut que créer ses propres docs, les lire (onSnapshot) et les clôturer
    // (timeout → status 'expired') — jamais s'auto-approuver via 'approved'.
    match /workflowApprovals/{approvalId} {
      allow read:   if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid
                                         && request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid
                                         && request.resource.data.status == 'expired';
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ── Logs de pipelines (observabilité) ────────────────────────────────────
    // Issue + dernières étapes des runs longs (enrichissement PIM, décompo
    // Image/PDF→SVG) écrits par recordPipelineRun (src/lib/pipelineLog.ts).
    // Create-only par le propriétaire ; lecture de ses propres runs.
    match /pipelineRuns/{runId} {
      allow read:   if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Journal d'audit (QUI/QUOI/QUAND) ───────────────────────
    // Immuable : créé par l'utilisateur (pour ses propres actions), lu par l'admin
    // (tout) ou par chacun pour ses propres entrées. Jamais modifiable/supprimable.
    match /auditLog/{logId} {
      allow read:   if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false; // immuable : une entrée n'est jamais modifiée
      // Purge autorisée : chacun peut effacer SES propres entrées, l'admin toutes.
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // ── Analytics de trafic (pages vues) ───────────────────────
    // Écriture UNIQUEMENT via la Cloud Function (Admin SDK contourne ces règles).
    // Lecture réservée à l'owner (dashboard analytics).
    match /analyticsEvents/{eventId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ── Telegram entrant (2a) ──────────────────────────────────
    // File des messages reçus : lisible/modifiable par tout utilisateur connecté
    // (l'app perso est mono-utilisateur ; le mapping chat_id→uid est hors périmètre 2a).
    match /telegramInbox/{messageId} {
      allow read, write: if isActiveUser();
    }

    // Config (secret webhook + allowlist) : JAMAIS accessible au client.
    // Seul le SDK admin de la Function y accède (il contourne les règles).
    match /telegramConfig/{docId} {
      allow read, write: if false;
    }
  }
}
